<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Каталог бань{% endblock %}</title>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="header">
            <h1 class="header__title">Каталог бань</h1>
            <span id="header__favourites-count">
                В избранном: {{ app.session.get('favourite', [])|length }}
            </span>
        </header>
        {% block body %}{% endblock %}
    </body>
    <turbo-frame id="modal" data-controller="modal"></turbo-frame>
</html>
