<turbo-stream action="replace" target="favourite-button-{{ projectId }}">
    <template>
        {{ include('project/_favourite_button.html.twig', {
            projectId: projectId,
            isFavourite: isFavourite,
        }) }}
    </template>
</turbo-stream>

<turbo-stream action="replace" target="favourites-count">
    <template>
        <span id="favourites-count">{{ count }}</span>
    </template>
</turbo-stream>