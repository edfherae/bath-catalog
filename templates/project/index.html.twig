{% extends "base.html.twig" %}

{% block title %}Каталог проектов{% endblock %}

{% block body %}
    <h1>Каталог проектов бань</h1>

    <turbo-frame id="projects-list" data-turbo-action="advance">
        <p>Найдено: {{ total }}, страница {{ page }} из {{ totalPages }}</p>

        <form method="GET" action="{{ path('app_projects') }}" data-controller="debounce">
            <h2>Фильтры:</h2>
            <p>Площадь:</p>
            <label>
                от
                <input type="number" name="area_min" value="{{ filter.areaMin ?: '' }}" min="0" data-action="input->debounce#submitWithDelay"/>
            </label>
            <label>
                до
                <input type="number" name="area_max" value="{{ filter.areaMax ?: '' }}" min="{{ filter.areaMin ?: 0 }}" data-action="input->debounce#submitWithDelay"/>
                м2
            </label>
            <fieldset>
                <legend>Этажность</legend>
                <label>
                    1 этаж
                    <input type="checkbox" name="floors[]" value="1" {% if 1 in filter.floors %} checked {% endif %} data-action="change->debounce#submitImmediately"
                    />
                </label>
                <label>
                    2 этажа
                    <input type="checkbox" name="floors[]" value="2" {% if 2 in filter.floors %} checked {% endif %} data-action="change->debounce#submitImmediately"
                    />
                </label>
            </fieldset>
            <label>
                Есть басcейн
                <input type="checkbox" name="has_pool" value="1" {% if filter.hasPool %} checked {% endif %} data-action="change->debounce#submitImmediately"
                >
            </label>
        </form>
        <ul class="list">
            {% for p in projects %}
                <li class="item">
                    <h2>{{ p.title }}</h2>
                    <img src="{{ p.imageUrl }}" alt="{{ p.title }}" width="200" height="150"/>
                    <p>{{ p.area }} м², {{ p.floors }} этажей</p>
                    {% if p.hasPool %}
                        <p>Есть бассейн</p>
                    {% else %}
                        <p>Нет бассейна</p>
                    {% endif %}
                    <a
                    class="button" 
                    href="{{ path('app_projects_modal', {id: p.id}) }}"
                    data-turbo-frame="modal"
                    >
                    Подробнее
                    </a>
                    {{ include('project/_favourite_button.html.twig', {
                        projectId: p.id,
                        isFavourite: p.id in favourites
                    }) }}
                </li>
            {% endfor %}
        </ul>
        {% if totalPages > 1 %}
            <nav class="pagination">
                <a 
                    class="{{ page <= 1 ? 'page-button button-disabled' : 'page-button'  }}"
                    href="{{ path('app_projects', queryParams|merge({page: page - 1})) }}"
                >
                    Назад
                </a>
                {% for p in 1..totalPages %}
                    {% if page == p %}
                        <span class="page-button button-current"
                        >{{ p }}</span>
                    {% else %}
                        <a 
                            class="page-button"
                            href="{{path('app_projects', 
                            queryParams|merge({page: p}))}}"
                        >
                            {{ p }}
                        </a>
                    {% endif %}
                {% endfor %}
                <a
                    class="{{ page >= totalPages ? 'page-button button-disabled' : 'page-button' }}"
                    href="{{ path('app_projects',
                    queryParams|merge({page: page + 1})) }}"
                >
                    Вперед
                </a>
            </nav>
        {% endif %}
        
    </turbo-frame>

{% endblock %}